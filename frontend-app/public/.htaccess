<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories as-is (assets, favicon, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send Angular routes such as /admin and /login to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>
